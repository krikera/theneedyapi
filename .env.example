# Server & Database Configuration
PORT=3000
MONGODB_URI=mongodb://localhost:27017/needy_api
# CORS allowed origin (comma-separated, e.g. http://localhost:3000,http://127.0.0.1:3000 or * for public)
CORS_ORIGIN=*

# Abandonment threshold in milliseconds
# 86400000 ms = 24 hours (for regular use)
# 60000 ms = 1 minute (for demonstrations & tests)
ABANDONMENT_THRESHOLD_MS=86400000

# Metabolic rate configuration
# Interval in milliseconds at which the hunger daemon ticks (e.g. 10800000 ms = 3 hours)
HUNGER_TICK_INTERVAL_MS=10800000

# Amount hunger increases per tick (0-100 scale)
HUNGER_INCREMENT_PER_TICK=5

